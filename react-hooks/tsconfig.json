{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "esnext",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": true,
    "strict": true,
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "noImplicitAny": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "paths": {
      "@components/common/*": ["../react-common/src/*"],
      "@components/hooks/*": ["./src/*"]
    }
  },
  "include": ["../react-common/src", "src"],
  "exclude": ["node_modules"]
}
